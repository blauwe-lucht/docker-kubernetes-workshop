{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string",
          "enum": ["blue", "green", "purple"]
        },
        "pullPolicy": { "type": "string" }
      }
    }
  }
}
