{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string",
          "enum": ["blue", "green", "purple"]
        },
        "pullPolicy": { "type": "string" }
      }
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "bindMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "hostPath", "mountPath"],
        "properties": {
          "name": { "type": "string" },
          "hostPath": { "type": "string" },
          "mountPath": { "type": "string" },
          "readOnly": { "type": "boolean" }
        }
      }
    }
  }
}
